            "label": "2026-06-10_16-22-49",
            "content": "package main\nimport \"fmt\"\n\nfunc primo(n int, div int) bool{\n    if n < 2{\n        return false\n    }\n    if div == 1{\n        return true\n    }\n    if n%div == 0{\n        return false\n    }\n    return primo(n, div-1)\n}\n\nfunc esimo(n, atual, cont int) int {\n    if primo(atual, atual-1){\n        cont++\n    }\n\n    if cont == n{\n        return atual\n    }\n\n    return esimo(n, atual+1, cont)\n}\n\nfunc main() {\n    var n int \n    fmt.Scan(&n)\n    \n    fmt.Println(esimo(n, 2, 0))\n}\n",
